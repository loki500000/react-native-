{
  "name": "figma-studio-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered IDE for converting Figma designs to production-ready React Native code",
  "workspaces": [
    "ide-app",
    "extensions/*",
    "ai-engine",
    "preview-server",
    "mcp-servers/*",
    "desktop-app"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:core": "tsc && webpack",
    "build:plugin": "webpack --config webpack.plugin.js",
    "build:cli": "tsc",
    "dev": "./scripts/dev.sh",
    "dev:core": "webpack --watch",
    "stop": "./scripts/stop.sh",
    "test": "lerna run test",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "clean": "lerna clean -y && rm -rf node_modules",
    "bootstrap": "lerna bootstrap"
  },
  "bin": {
    "figma-rn": "dist/cli/index.js"
  },
  "keywords": [
    "figma",
    "react-native",
    "code-generator",
    "design-to-code",
    "figma-plugin",
    "design-tokens"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@figma/plugin-typings": "^1.89.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "html-webpack-plugin": "^5.5.4",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "lerna": "^8.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
