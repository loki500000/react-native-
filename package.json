{
  "name": "figma-to-react-native",
  "version": "1.0.0",
  "description": "A comprehensive Figma to React Native code generator with CLI and plugin support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "figma-rn": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && webpack",
    "build:plugin": "webpack --config webpack.plugin.js",
    "build:cli": "tsc",
    "dev": "webpack --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\""
  },
  "keywords": [
    "figma",
    "react-native",
    "code-generator",
    "design-to-code",
    "figma-plugin",
    "design-tokens"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@figma/plugin-typings": "^1.89.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "html-webpack-plugin": "^5.5.4",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
