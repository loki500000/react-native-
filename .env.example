# Figma Studio AI - Environment Configuration
# Copy this file to .env and fill in your API keys

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Required API Keys
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Figma Personal Access Token
# Get it here: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key (for AI features)
# Get it here: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq Model Selection (optional)
# Options: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Server Ports (optional, defaults shown)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# IDE Server Port
IDE_SERVER_PORT=3000

# AI Engine Port
AI_ENGINE_PORT=3001

# Preview Server Port
PREVIEW_SERVER_PORT=3002

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MCP Backend Integrations (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Bubble.io Configuration
# Get API token from: https://bubble.io/api/v1
BUBBLE_APP_NAME=your-app-name
BUBBLE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx
BUBBLE_VERSION=live

# Supabase Configuration
# Get credentials from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx

# Firebase Configuration (Optional)
# Get credentials from: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxx
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-app.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-app.appspot.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Development Settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable debug logging
DEBUG=false

# Expo Snack SDK Version
EXPO_SDK_VERSION=49.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Quick Start Guide
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Get Figma Token:
#    - Go to Figma → Settings → Account
#    - Scroll to "Personal access tokens"
#    - Generate new token
#
# 3. Get Groq API Key:
#    - Sign up at https://console.groq.com
#    - Go to API Keys
#    - Create new API key
#
# 4. (Optional) Configure backends:
#    - Bubble.io, Supabase, or Firebase
#    - Only needed if you want backend integration
#
# 5. Start development:
#    ./scripts/dev.sh
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
